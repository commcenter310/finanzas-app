VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GROQ_API_KEY=
# Opcionales: Groq retira modelos con frecuencia (console.groq.com/docs/deprecations)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_VOZ=whisper-large-v3-turbo

WHATSAPP_VERIFY_TOKEN=
# Obligatorio: App Secret de la app de Meta (Configuración > Básica). Sin él el
# webhook rechaza todos los mensajes (no puede comprobar que vienen de Meta).
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Solo para pruebas locales: false apaga la verificación de firma
# WHATSAPP_REQUIRE_SIGNATURE=true
# WHATSAPP_GRAPH_VERSION=v25.0

# Zona horaria para fechar los movimientos del bot (por defecto America/Mazatlan)
# APP_TIME_ZONE=America/Mazatlan
